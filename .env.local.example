# Supabase(プロジェクト設定 > API から取得。無料枠で運用可能)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
# service_role キーはサーバー専用。絶対にクライアントに渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# Google Gemini API(aistudio.google.com で発行。クレジットカード不要の無料枠あり)
# 翻訳・要約・カテゴリ分類・ファクトチェック(Google Search Grounding併用)に使用。
# このアプリの想定利用量(1日10記事程度)なら無料枠の範囲で運用できる見込み。
GEMINI_API_KEY=xxxxxxxxxxxx
# 省略時のデフォルトモデル(実機で無料枠での動作を確認済み)
GEMINI_MODEL=gemini-3.5-flash-lite

# /api/cron/ingest 保護用シークレット(任意の乱数文字列。GitHub Actionsから
# Authorization: Bearer ヘッダーに付けて叩く。ローカルで手動実行する際にも使用)
CRON_SECRET=change-me-to-a-random-string

# 収集パイプラインの挙動調整(任意、未設定時はコード側のデフォルト値を使用)。
# この.env.localの値は「ローカル実行(npm run ingest:local、Ollama)」にのみ影響する。
# Vercel(本番、Gemini)側は vercel env で別途管理しているため、ここでの値とは独立。
#
# - Vercel(本番/Gemini): 実機検証の結果、1回10件だとサーバーレス関数のタイムアウト
#   (60秒)に達するため 5件 を推奨。その代わりGitHub Actionsの実行頻度を上げて
#   (README「定期収集の設定」参照)日々の合計収集数を確保する
# - ローカル(Ollama): 無料・タイムアウト制限が無いため、まとめて多めに処理してOK
MAX_SOURCES_PER_RUN=20
MAX_ARTICLES_PER_RUN=30
# true にすると Google Search Grounding を使ったファクトチェックになるが、
# 動作確認の結果、この機能はGoogle Cloud側で課金設定(Billing有効化)が必要だった
# (無料枠のみのアカウントだと429エラーになる)。クレジットカード登録なしで運用する場合は
# false のままにしておくこと(本文の内部矛盾・妥当性のみで判定する簡易ファクトチェックになる)。
ENABLE_WEB_SEARCH_FACTCHECK=false

# --- ローカルLLM(Ollama)で収集する場合のみ設定(npm run ingest:local が使用) ---
# 上記のGemini設定とは独立で、README「ローカルLLMで完全無料運用する」を参照。
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# --- AIラジオ機能(npm run radio:generate が使用。README「AIラジオ機能」参照) ---
# VOICEVOX_HOST=http://127.0.0.1:50021
# VOICEVOX_SPEAKER=2
# RADIO_HOURS_LOOKBACK=24
# RADIO_MAX_ARTICLES=15
